{
  "name": "alchemy-new-publish-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that publishes a ready archive to the alchemy.new package registry.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --banner:js=\"/* alchemy-new-publish-action */\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check-dist": "npm run build && git diff --exit-code -- dist",
    "all": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "ignore": "^7.0.5",
    "minizlib": "^3.1.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.11",
    "eslint": "^10.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
